{
  "name": "surge-desktop",
  "version": "0.4.3",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "build": "node build.cjs",
    "build:dev": "node build.cjs --development",
    "dev": "node build.cjs --development && electron .",
    "start": "electron .",
    "test": "node --test security.test.cjs runtime.test.cjs startup.test.cjs case-library.test.cjs case-recovery.test.cjs survive-boundary.test.cjs investigations-boundary.test.cjs investigation-export.test.cjs survive-flow.test.cjs developer-tools.test.cjs presentation.test.cjs",
    "test:inspector": "node developer-inspector-ui.test.cjs",
    "test:library": "node library-ui.test.cjs",
    "test:saved-flow": "node saved-flow.test.cjs && node saved-context.test.cjs",
    "test:accessibility": "node accessibility.test.cjs",
    "test:stream": "node stream.test.cjs",
    "test:survive": "node build.cjs && node survive.test.cjs",
    "test:timeline": "node build.cjs && node timeline-layout.test.cjs",
    "test:investigations": "node build.cjs && node investigations.test.cjs",
    "test:ui": "node parity.cjs && node evaluation.test.cjs",
    "format:check": "prettier --check \"*.cjs\" \"src/**/*.{jsx,css,html}\" package.json",
    "format": "prettier --write \"*.cjs\" \"src/**/*.{jsx,css,html}\" package.json"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "esbuild": "0.25.12",
    "playwright": "1.62.1",
    "prettier": "3.9.10"
  },
  "description": "Local telemetry investigation and detection evaluation",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.25.0"
}
